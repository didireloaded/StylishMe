# Server-only secret. Configure it in the hosting secret manager; never expose it to browser code.
OPENAI_API_KEY=

# Optional override. StylishMe defaults to the current portrait-capable GPT Image model.
OPENAI_IMAGE_MODEL=gpt-image-2
# Shared server-only key used by the private owner dashboard.
STYLISHME_ADMIN_API_KEY=

# Independent random salt for one-way analytics identifiers.
ACTIVITY_HASH_SALT=
