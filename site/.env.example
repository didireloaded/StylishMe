# Server-only secret. Configure it in the hosting secret manager; never expose it to browser code.
OPENAI_API_KEY=

# Optional override. StylishMe defaults to the current portrait-capable GPT Image model.
OPENAI_IMAGE_MODEL=gpt-image-2
# Shared server-only key used by the private owner dashboard.
STYLISHME_ADMIN_API_KEY=

# Independent random salt for one-way analytics identifiers.
ACTIVITY_HASH_SALT=

# Canonical HTTPS origin used in payment, account-email and OAuth callbacks.
PUBLIC_APP_ORIGIN=

# Transactional email (verified sending domain required).
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# DPO Pay hosted checkout. Card details never pass through StylishMe.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/
DPO_CHECKOUT_URL=https://secure.3gdirectpay.com/payv2.php

# DHL shipment tracking (production subscription key; demo keys are rejected).
DHL_API_KEY=
DHL_TRACKING_API_URL=https://api-eu.dhl.com/track/shipments

# Google OpenID Connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple for web. Prefer the private-key fields so client secrets are short-lived.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Optional pre-generated client secret; rotate it before expiry if used.
APPLE_CLIENT_SECRET=

# 32 random bytes encoded as base64url. Encrypts provider revocation credentials at rest.
AUTH_CREDENTIAL_ENCRYPTION_KEY=